# Copy to .env.local and fill in. Without AUTH_SECRET the site still works for guests
# (progress saved in the browser); sign-up and sign-in are switched off.

# Email of the one admin account (it can't be registered through the sign-up form).
ADMIN_EMAIL=you@example.com
# scrypt hash of the admin password: npm run hash-password -- "your password"
ADMIN_PASSWORD_HASH=
# Long random string used to sign session cookies: openssl rand -hex 32
AUTH_SECRET=

# Public URL of the deployed site, for share images, canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://example.com
